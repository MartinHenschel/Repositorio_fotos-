<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php\d|pht|phar|cgi|pl|py|sh)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php\d|pht|phar|cgi|pl|py|sh)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
