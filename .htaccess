# Arquivos de configuração, banco e dados internos nunca devem ser públicos.
<FilesMatch "^(\.env|.*\.(sqlite|log|json|txt))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Impede a exposição de arquivos ocultos, exceto o próprio .htaccess.
<FilesMatch "^\.(?!htaccess$).+">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>